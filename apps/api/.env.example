# =============================================================================
# @crucible/api Environment Variables
# =============================================================================

# Server Port & Environment
PORT=4000
NODE_ENV=development

# Database (Neon Serverless PostgreSQL for Free Production, Docker for Local Dev)
# Local Dev: postgresql://crucible:crucible_dev_pass@localhost:5433/crucible_dev?schema=public
# Production (Neon): postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://crucible:crucible_dev_pass@localhost:5433/crucible_dev?schema=public
# DIRECT_URL is required for Prisma migrations when using Neon pooled connections
# DIRECT_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require

# Redis (Upstash Free Tier for Production, Docker for Local Dev)
# Local Dev: redis://localhost:6379
# Production (Upstash): rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
SESSION_SECRET=super-secret-session-key-replace-in-production-min-32-chars
ROOM_TOKEN_SECRET=super-secret-room-token-key-replace-in-production-32-chars
COLLAB_TOKEN_SECRET=super-secret-collab-token-key-must-match-collab-server

# Password Reset Token Logging (Default false; enable only for live demo on Render)
LOG_PASSWORD_RESET_LINKS=false

# WebRTC Video & Audio (LiveKit Cloud Free Build Plan)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Code Execution Provider (rapidapi | self_hosted)
# Production Deployment: rapidapi (Free plan on RapidAPI, 50 submissions/day)
# Local Development: self_hosted (Local Docker Judge0)
EXECUTION_PROVIDER=self_hosted
JUDGE0_URL=http://localhost:2358
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# File & Recording Storage (Supabase Storage S3-Compatible API - Free Tier)
# Endpoint format: https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=crucible-recordings
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key

# Transactional Email (Brevo Free Plan - 300 emails/day)
# Free tier requires a single verified sender email in Brevo.
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Crucible
APP_URL=http://localhost:3000

# Demo Seeding (Manual CLI only: pnpm --filter @crucible/api db:seed)
# DEMO_INTERVIEWER_PASSWORD=YourSecureDemoPassword123!

