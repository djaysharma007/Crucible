# =============================================================================
# @crucible/web Environment Variables
# =============================================================================

# In local dev: leave empty to use relative /api/v1 (proxied by Next.js rewrites)
# or specify http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Target API for Next.js first-party rewrites (/api/v1/* -> API_PROXY_TARGET/api/v1/*)
# Local Dev: http://localhost:4000
# Production: https://crucible-api.onrender.com
API_PROXY_TARGET=http://localhost:4000

# Collab WebSocket Server
# Local Dev: ws://localhost:4001
# Production: wss://crucible-collab.onrender.com
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4001
