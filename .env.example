# Environment configuration template for Crucible

# App Environment
NODE_ENV=development

# Web Frontend (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4001

# API Backend (NestJS)
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Collab Server (Hocuspocus)
COLLAB_PORT=4001

# PostgreSQL Database
DATABASE_URL=postgresql://crucible:crucible_dev_pass@localhost:5432/crucible_dev?schema=public
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_dev_pass
POSTGRES_DB=crucible_dev
POSTGRES_PORT=5432

# Redis Cache & Presence
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=crucible_minio_admin
S3_SECRET_KEY=crucible_minio_secret
S3_BUCKET_NAME=crucible-artifacts
MINIO_CONSOLE_PORT=9001

# Security & Sessions
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars
ROOM_TOKEN_SECRET=dev_room_token_secret_change_in_production_32_chars

# Media (LiveKit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Code Execution (Judge0)
JUDGE0_URL=http://localhost:2358

