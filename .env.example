# =============================================================================
# Crucible Master Environment Template
# Zero-Cost Production Stack & Local Development
# =============================================================================

# Global Settings
NODE_ENV=development

# -----------------------------------------------------------------------------
# Web Frontend (Vercel Free Tier / Local Dev)
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4001

# -----------------------------------------------------------------------------
# API Backend (Render Free Web Service / Local Dev)
# -----------------------------------------------------------------------------
PORT=4000
API_PORT=4000
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
COLLAB_TOKEN_SECRET=super-secret-collab-token-key-must-match-collab-server
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Collab WebSocket Server (Render Free Web Service / Local Dev)
# -----------------------------------------------------------------------------
COLLAB_PORT=4001

# -----------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL / Local Docker)
# Local: postgresql://crucible:crucible_dev_pass@localhost:5433/crucible_dev?schema=public
# Production: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://crucible:crucible_dev_pass@localhost:5433/crucible_dev?schema=public
# DIRECT_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_dev_pass
POSTGRES_DB=crucible_dev
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# Redis (Upstash Free Tier / Local Docker)
# Local: redis://localhost:6379
# Production: rediss://default:[password]@[endpoint].upstash.io:6379
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# WebRTC Audio, Video & Screen Share (LiveKit Cloud Free Build Plan)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# -----------------------------------------------------------------------------
# Code Execution (Judge0 CE on RapidAPI Free Tier / Local Docker)
# EXECUTION_PROVIDER=rapidapi (Production: 50 submissions/day limit)
# EXECUTION_PROVIDER=self_hosted (Local Docker Judge0)
# -----------------------------------------------------------------------------
EXECUTION_PROVIDER=self_hosted
JUDGE0_URL=http://localhost:2358
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_JUDGE0_HOST=judge0-ce.p.rapidapi.com

# -----------------------------------------------------------------------------
# Storage (Supabase Storage S3-Compatible API - Free Tier)
# -----------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=crucible-recordings
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key

# -----------------------------------------------------------------------------
# Transactional Email (Brevo Free Plan - 300 emails/day)
# -----------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Crucible

# -----------------------------------------------------------------------------
# Manual Demo Seed Script Password (db:seed only, never in production startup)
# -----------------------------------------------------------------------------
# DEMO_INTERVIEWER_PASSWORD=DemoPassword123!
