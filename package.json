{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"WEB,API\" -c \"cyan,yellow\" \"pnpm --filter @crucible/web dev\" \"pnpm --filter @crucible/api dev\"",
    "dev:collab": "pnpm --filter @crucible/collab dev",
    "build": "pnpm --filter @crucible/shared build && pnpm --filter @crucible/api build && pnpm --filter @crucible/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "prisma:generate": "pnpm --filter @crucible/api prisma:generate",
    "seed": "pnpm --filter @crucible/api seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
